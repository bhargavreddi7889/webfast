# Copy to .env.local and fill in your values (never commit .env.local)
# IMPORTANT: Restart `npm run dev` after changing this file.

NEXT_PUBLIC_SITE_URL=https://www.webfasttech.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Use quotes if the value contains spaces: "Name <email@domain.com>"
# Test mode: onboarding@resend.dev | Production: use your verified domain email
RESEND_FROM_EMAIL="Web Fast Technology <onboarding@resend.dev>"

# Where leads, contact forms, and payment alerts are delivered
CONTACT_EMAIL_TO=your-inbox@example.com
