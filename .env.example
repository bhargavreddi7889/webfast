# Copy to .env.local and fill in your values (never commit .env.local)
# Site URL (used for SEO, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.webfasttech.com

# Resend API — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Optional in dev (defaults to onboarding@resend.dev if empty)
RESEND_FROM_EMAIL=

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=contact@yourdomain.com
